rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // An admin is someone whose email is dipenderchahal615@gmail.com, or is explicitly in the admins collection.
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "dipenderchahal615@gmail.com" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isServer() {
      // Allow write if the payload includes a specific serverSecret.
      // This is a workaround for server-side cron jobs without Admin SDK credentials.
      return request.resource.data.serverSecret == "STUDENTHELP_CRON_SECRET_2026";
    }

    match /users/{userId} {
      allow read, write: if (isSignedIn() && request.auth.uid == userId) || (!isSignedIn());
    }
    
    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      // Anyone can read blogs
      allow read: if true;
      // Admins and Server can write
      allow write: if isAdmin() || isServer();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isServer();
    }
    
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin() || isServer();
    }
    
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /automationSettings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    match /automationRuns/{runId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isServer();
    }

    match /{collection}/{docId} {
      // General rule for existing collections (notes, portfolios, etc)
      allow read, update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || (!isSignedIn());
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || (!isSignedIn());
    }
  }
}
